	<!-- This is the routing service configuration for this example -->
	<routing_service name="example_WanZonalInternal">

		<annotation>
			<documentation>
				Wan Internal for Zonal Controller
			</documentation>
		</annotation>

		<domain_route name="DomainRoute">
			<participant name="domain0">
				<domain_id>0</domain_id>
				<participant_qos>
					<transport_builtin>
						<mask>UDPv4</mask>
					</transport_builtin>
				</participant_qos>
				<register_type name="WindowCommand" type_ref="WindowCommand"/>
				<register_type name="WindowUpdate" type_ref="WindowUpdate"/>
			</participant>
			<participant name="domain1">
				<domain_id>1</domain_id>
				<participant_qos>
					<transport_builtin>
						<mask>UDPv4_WAN</mask>
					</transport_builtin>
					<discovery>
						<!-- Accept unknown peers has to be set to true when private participants are
                        configured.
                            The peer that replies may have a different locator than the ones set here in initial_peers -->
						<accept_unknown_peers>true</accept_unknown_peers>
						<initial_peers>
							<element>
								rtps@udpv4_wan://$(eip01_eip):80
							</element>
						</initial_peers>
					</discovery>
				</participant_qos>
				<register_type name="WindowCommand" type_ref="WindowCommand"/>
